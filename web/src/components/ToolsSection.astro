---
import { TOOLS } from '../data/appData';
import { 
  FileText, 
  FileEdit, 
  FilePlus, 
  Search, 
  FolderTree, 
  Trash2, 
  Terminal, 
  Check, 
  ChevronRight,
  ShieldCheck,
  Wrench
} from 'lucide-astro';

const toolIcons: Record<string, any> = {
  read: FileText,
  edit: FileEdit,
  write: FilePlus,
  search: Search,
  list: FolderTree,
  delete: Trash2,
  bash: Terminal,
};
---

<section id="tools" class="py-24 relative z-10 border-t border-[#8296DC]/12 bg-[#05070C]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#10B981]/10 text-[#6EE7B7] border border-[#10B981]/25 font-mono">
        <Wrench class="w-3 h-3 text-[#10B981]" />
        <span>Autonomous Tools</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F8FAFF]">
        Built-in Agent Tooling Engine
      </h2>
      <p class="text-base sm:text-lg text-[#9EA8B8]">
        Every tool is implemented in native Dart/Flutter with strict safety bounds, token conservation, and collision prevention.
      </p>
    </div>

    <!-- Interactive Tools Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Tool Navigation (4 cols) -->
      <div class="lg:col-span-4 space-y-2">
        {TOOLS.map((tool, index) => {
          const IconComponent = toolIcons[tool.name] || FileText;
          return (
            <button
              class={`tool-nav-btn w-full text-left p-3.5 rounded-2xl border transition-all flex items-center justify-between group cursor-pointer ${index === 0 ? 'bg-[#141F33] border-[#6684FF]/50 shadow-md shadow-[#6684FF]/10' : 'bg-[#080C14] border-[#8296DC]/12 hover:border-[#8296DC]/30'}`}
              data-tool-id={tool.name}
            >
              <div class="flex items-center gap-3">
                <div class={`w-8 h-8 rounded-xl flex items-center justify-center ${index === 0 ? 'bg-[#6684FF] text-white' : 'bg-[#0D1420] text-[#91A7FF] group-hover:text-white'} transition-colors`}>
                  <IconComponent class="w-4 h-4" />
                </div>
                <div class="space-y-0.5">
                  <span class="font-mono text-sm font-bold text-[#F8FAFF] group-hover:text-white block">
                    {tool.name}
                  </span>
                  <span class="text-[11px] text-[#667085] block font-mono">
                    {tool.category}
                  </span>
                </div>
              </div>
              
              <ChevronRight class="w-4 h-4 text-[#667085] group-hover:text-[#91A7FF] transition-colors" />
            </button>
          );
        })}
      </div>

      <!-- Tool Detail Panel (8 cols) -->
      <div class="lg:col-span-8">
        {TOOLS.map((tool, index) => (
          <div
            id={`tool-panel-${tool.name}`}
            class={`tool-panel shiny-glass rounded-3xl p-6 sm:p-8 space-y-6 border border-[#8296DC]/20 ${index === 0 ? 'block' : 'hidden'}`}
          >
            <!-- Tool Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-[#8296DC]/12">
              <div class="space-y-1">
                <div class="flex items-center gap-3">
                  <h3 class="text-2xl font-bold font-mono text-[#F8FAFF]">{tool.name}</h3>
                  <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-semibold bg-[#6684FF]/15 text-[#91A7FF] border border-[#6684FF]/30">
                    {tool.category}
                  </span>
                </div>
                <p class="text-sm text-[#9EA8B8]">{tool.description}</p>
              </div>

              <div class="shrink-0 flex items-center gap-1.5 px-3 py-1 rounded-xl bg-[#080C14] border border-[#8296DC]/20 text-xs font-mono text-[#6EE7B7]">
                <ShieldCheck class="w-3.5 h-3.5" />
                <span>On-Device Safe</span>
              </div>
            </div>

            <!-- Tool Signature -->
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-wider text-[#667085] font-mono">Signature</div>
              <div class="p-3.5 rounded-2xl bg-[#030509] border border-[#8296DC]/15 font-mono text-xs text-[#91A7FF] overflow-x-auto">
                <code>{tool.signature}</code>
              </div>
            </div>

            <!-- Parameters Table -->
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-wider text-[#667085] font-mono">Parameters</div>
              <div class="rounded-2xl border border-[#8296DC]/15 overflow-hidden bg-[#080C14]">
                <table class="w-full text-left text-xs font-sans">
                  <thead class="bg-[#0D1420] text-[#9EA8B8] border-b border-[#8296DC]/10 font-mono">
                    <tr>
                      <th class="p-3">Parameter</th>
                      <th class="p-3">Type</th>
                      <th class="p-3">Required</th>
                      <th class="p-3">Description</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-[#8296DC]/10 text-[#F8FAFF]">
                    {tool.params.map((p) => (
                      <tr class="hover:bg-[#141F33]/40 transition-colors">
                        <td class="p-3 font-mono font-bold text-[#91A7FF]">{p.name}</td>
                        <td class="p-3 font-mono text-[#FCD34D]">{p.type}</td>
                        <td class="p-3">
                          {p.required ? (
                            <span class="text-[#EF4444] font-semibold font-mono text-[11px]">required</span>
                          ) : (
                            <span class="text-[#667085] font-mono text-[11px]">optional</span>
                          )}
                        </td>
                        <td class="p-3 text-[#9EA8B8]">{p.description}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <!-- Example Invocation & Return -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
              <div class="space-y-1.5">
                <div class="text-xs font-semibold uppercase tracking-wider text-[#667085] font-mono">Example Call</div>
                <div class="p-4 rounded-2xl bg-[#030509] border border-[#8296DC]/15 font-mono text-xs text-[#F8FAFF] overflow-x-auto min-h-[90px]">
                  <pre class="whitespace-pre-wrap">{tool.example}</pre>
                </div>
              </div>

              <div class="space-y-1.5">
                <div class="text-xs font-semibold uppercase tracking-wider text-[#667085] font-mono">Return Output</div>
                <div class="p-4 rounded-2xl bg-[#030509] border border-[#8296DC]/15 font-mono text-xs text-[#6EE7B7] overflow-x-auto min-h-[90px]">
                  <pre class="whitespace-pre-wrap">{tool.resultExample}</pre>
                </div>
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  const navButtons = document.querySelectorAll<HTMLButtonElement>('.tool-nav-btn');
  const panels = document.querySelectorAll<HTMLDivElement>('.tool-panel');

  navButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const toolId = btn.getAttribute('data-tool-id');

      navButtons.forEach((b) => {
        b.classList.remove('bg-[#141F33]', 'border-[#6684FF]/50', 'shadow-md', 'shadow-[#6684FF]/10');
        b.classList.add('bg-[#080C14]', 'border-[#8296DC]/12');
        const iconContainer = b.querySelector('div > div');
        if (iconContainer) {
          iconContainer.classList.remove('bg-[#6684FF]', 'text-white');
          iconContainer.classList.add('bg-[#0D1420]', 'text-[#91A7FF]');
        }
      });

      btn.classList.add('bg-[#141F33]', 'border-[#6684FF]/50', 'shadow-md', 'shadow-[#6684FF]/10');
      btn.classList.remove('bg-[#080C14]', 'border-[#8296DC]/12');
      const activeIcon = btn.querySelector('div > div');
      if (activeIcon) {
        activeIcon.classList.add('bg-[#6684FF]', 'text-white');
        activeIcon.classList.remove('bg-[#0D1420]', 'text-[#91A7FF]');
      }

      panels.forEach((p) => {
        if (p.id === `tool-panel-${toolId}`) {
          p.classList.remove('hidden');
          p.classList.add('block');
        } else {
          p.classList.add('hidden');
          p.classList.remove('block');
        }
      });
    });
  });
</script>
