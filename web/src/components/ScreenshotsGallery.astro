---
import { Smartphone, Sparkles, Terminal, Layers, Activity, CheckCircle2 } from 'lucide-astro';

interface ScreenshotItem {
  id: string;
  title: string;
  category: string;
  description: string;
  badge: string;
  features: string[];
}

const screenshots: ScreenshotItem[] = [
  {
    id: 'chat-tools',
    title: 'Autonomous Coding Chat & Tool Cards',
    category: 'Agent Engine',
    badge: 'Core UI',
    description: 'Real-time streaming agent with reasoning traces, expandable tool execution diffs, and precise syntax highlighting.',
    features: ['Expandable Tool Cards', 'Real-time Streaming', 'Thinking Trace Accordion', 'Instant Undo & Retry']
  },
  {
    id: 'providers',
    title: 'Provider Selector & Google OAuth',
    category: 'AI Connectivity',
    badge: 'Zero Lock-in',
    description: 'Switch between Google Cloud Code Assist OAuth, DeepSeek R1/V3, OpenRouter, and custom endpoints.',
    features: ['PKCE Deep-link OAuth', 'Custom Base URL & Keys', 'Dynamic Model Discovery', 'Secure Keystore Storage']
  },
  {
    id: 'runtime-terminal',
    title: 'Arch Linux Rootless PRoot Terminal',
    category: 'Execution Environment',
    badge: 'ARM64 Linux',
    description: 'Built-in Arch Linux PRoot environment with pacman package manager, full compiler support, and Termux bridge option.',
    features: ['Rootless PRoot v5.1', 'pacman / python / nodejs', 'Termux RUN_COMMAND Bridge', 'Project Sandboxing']
  },
  {
    id: 'projects-diagnostics',
    title: 'Local Projects & System Diagnostics',
    category: 'Storage & Diagnostics',
    badge: 'On-Device',
    description: 'Local project directory picker, recent workspaces, atomic JSONL session stats, and storage migration health.',
    features: ['Direct Storage Access', 'Atomic JSONL Integrity', 'Live Memory Diagnostics', 'Channel Update Manager']
  }
];
---

<section id="screenshots" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#6684FF]/10 text-[#91A7FF] border border-[#6684FF]/25 font-mono">
        <Smartphone class="w-3 h-3 text-[#6684FF]" />
        <span>Mobile-First Interface</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F8FAFF]">
        Engineered for Coding on Android
      </h2>
      <p class="text-base sm:text-lg text-[#9EA8B8]">
        Every UI screen, curve, and animation in Syntac is tuned for 60/90/120Hz mobile devices with dark glass aesthetics.
      </p>
    </div>

    <!-- Screenshots Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {screenshots.map((item, index) => (
        <div class="shiny-glass rounded-3xl p-6 sm:p-7 flex flex-col justify-between border border-[#8296DC]/15 group">
          
          <!-- Card Header -->
          <div class="flex items-center justify-between gap-4 mb-5">
            <div class="space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-[#91A7FF] font-semibold">{item.category}</span>
              <h3 class="text-lg font-bold text-[#F8FAFF] group-hover:text-white transition-colors">{item.title}</h3>
            </div>
            <span class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-mono font-semibold bg-[#0D1420] text-[#9EA8B8] border border-[#8296DC]/20">
              {item.badge}
            </span>
          </div>

          <!-- Interactive UI Mockup Surface -->
          <div class="relative rounded-2xl bg-[#030509] border border-[#8296DC]/15 overflow-hidden aspect-[16/10] mb-5 flex flex-col justify-between p-4 font-mono text-xs group-hover:border-[#6684FF]/30 transition-all">
            
            <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-[#6684FF]/10 rounded-full blur-2xl"></div>

            {index === 0 && (
              <div class="space-y-2 w-full">
                <div class="flex items-center justify-between text-[11px] text-[#667085] pb-2 border-b border-[#8296DC]/10">
                  <span class="text-[#91A7FF]">Agent Session</span>
                  <span class="text-[#10B981]">Streaming Active</span>
                </div>
                <div class="p-2.5 rounded-xl bg-[#0F1726]/80 border border-[#6684FF]/30 text-[11px] text-[#F8FAFF] space-y-1">
                  <div class="text-[#91A7FF] font-semibold">tool_call: edit (lib/src/engine.dart)</div>
                  <div class="text-[#FCA5A5] bg-[#EF4444]/10 px-1 rounded-xs">- void startRuntime() &#123;</div>
                  <div class="text-[#6EE7B7] bg-[#10B981]/10 px-1 rounded-xs">+ Future&lt;void&gt; startRuntime() async &#123;</div>
                </div>
              </div>
            )}

            {index === 1 && (
              <div class="space-y-2.5 w-full">
                <div class="flex items-center justify-between text-[11px] text-[#667085] pb-2 border-b border-[#8296DC]/10">
                  <span>Provider Hub</span>
                  <span class="text-[#91A7FF]">Google OAuth PKCE</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-[10px]">
                  <div class="p-2 rounded-xl bg-[#0D1420] border border-[#6684FF]/40 text-[#F8FAFF]">
                    <div class="font-bold text-[#91A7FF]">Google Cloud Code</div>
                    <div class="text-[#667085]">gemini-3.1-pro</div>
                  </div>
                  <div class="p-2 rounded-xl bg-[#0D1420] border border-[#8296DC]/20 text-[#9EA8B8]">
                    <div class="font-bold text-white">DeepSeek R1</div>
                    <div class="text-[#667085]">deepseek-reasoner</div>
                  </div>
                </div>
              </div>
            )}

            {index === 2 && (
              <div class="space-y-2 w-full text-[10.5px]">
                <div class="flex items-center justify-between text-[11px] text-[#667085] pb-2 border-b border-[#8296DC]/10">
                  <span>Arch Linux Container</span>
                  <span class="text-[#10B981]">PRoot Mounted</span>
                </div>
                <div class="text-[#9EA8B8] space-y-0.5">
                  <p class="text-[#F8FAFF]"><span class="text-[#6684FF]">[syntac@arm64]$</span> pacman -Q nodejs</p>
                  <p class="text-[#6EE7B7]">nodejs 22.14.0-1</p>
                </div>
              </div>
            )}

            {index === 3 && (
              <div class="space-y-2 w-full text-[10.5px]">
                <div class="flex items-center justify-between text-[11px] text-[#667085] pb-2 border-b border-[#8296DC]/10">
                  <span>Diagnostics</span>
                  <span class="text-[#10B981]">All Systems Green</span>
                </div>
                <div class="grid grid-cols-2 gap-2 text-[10px]">
                  <div class="p-2 rounded-xl bg-[#0D1420] border border-[#8296DC]/15">
                    <span class="text-[#667085]">Storage:</span>
                    <p class="text-[#6EE7B7] font-bold">JSONL Atomic</p>
                  </div>
                  <div class="p-2 rounded-xl bg-[#0D1420] border border-[#8296DC]/15">
                    <span class="text-[#667085]">Channel:</span>
                    <p class="text-[#91A7FF] font-bold">Beta Channel</p>
                  </div>
                </div>
              </div>
            )}

            <div class="pt-2 flex items-center justify-between text-[10px] text-[#667085] border-t border-[#8296DC]/10">
              <span>Android 8.0+</span>
              <span class="font-mono text-[#91A7FF]">Syntac Preview Frame</span>
            </div>
          </div>

          <!-- Description and Feature Pills -->
          <div class="space-y-3">
            <p class="text-sm text-[#9EA8B8] leading-relaxed">
              {item.description}
            </p>
            
            <div class="flex flex-wrap gap-2 pt-1">
              {item.features.map((feat) => (
                <span class="px-2.5 py-1 rounded-lg text-xs bg-[#080C14] text-[#9EA8B8] border border-[#8296DC]/15 font-mono flex items-center gap-1">
                  <CheckCircle2 class="w-3 h-3 text-[#10B981]" />
                  <span>{feat}</span>
                </span>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
