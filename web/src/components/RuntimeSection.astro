---
import { Terminal, Copy, Check, ShieldCheck, Cpu, Box, Sparkles } from 'lucide-astro';
---

<section id="runtime" class="py-24 relative z-10 border-t border-[#8296DC]/12 bg-[#05070C]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#6684FF]/10 text-[#91A7FF] border border-[#6684FF]/25 font-mono">
        <Terminal class="w-3 h-3 text-[#6684FF]" />
        <span>Execution Engine</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F8FAFF]">
        Rootless Arch Linux & Termux Runtimes
      </h2>
      <p class="text-base sm:text-lg text-[#9EA8B8]">
        Execute project shell commands directly on your phone using the packaged PRoot Arch Linux rootfs or your existing Termux setup.
      </p>
    </div>

    <!-- Dual Architecture Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      
      <!-- Card 1: Packaged Arch Linux PRoot Runtime -->
      <div class="shiny-glass rounded-3xl p-6 sm:p-8 space-y-6 border border-[#8296DC]/15 flex flex-col justify-between">
        <div class="space-y-5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-[#0D1420] border border-[#8296DC]/25 flex items-center justify-center text-[#91A7FF]">
                <Box class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#F8FAFF]">Built-in Arch Linux PRoot</h3>
                <p class="text-xs font-mono text-[#10B981]">Standalone • Zero-Root • ARM64</p>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold font-mono bg-[#10B981]/15 text-[#6EE7B7] border border-[#10B981]/30">
              Bundled Default
            </span>
          </div>

          <p class="text-sm text-[#9EA8B8] leading-relaxed">
            Extracts the packaged rootfs bundle (<code class="text-[#91A7FF] font-mono text-xs">arch-linux-rootfs-v1.bundle</code>) directly into app-private storage. Emulates system calls in userspace without modifying Android system partitions.
          </p>

          <!-- Feature List -->
          <ul class="space-y-2.5 text-xs text-[#F8FAFF] font-mono">
            <li class="flex items-center gap-2.5">
              <span class="text-[#10B981] font-bold">✓</span>
              <span><strong class="text-white font-sans">Pacman:</strong> Full access to official Arch repositories</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#10B981] font-bold">✓</span>
              <span><strong class="text-white font-sans">Compilers:</strong> Run python, nodejs, rustc, clang on device</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#10B981] font-bold">✓</span>
              <span><strong class="text-white font-sans">Sandboxing:</strong> Safe execution bounded to selected project directory</span>
            </li>
          </ul>
        </div>

        <!-- Terminal Snippet -->
        <div class="rounded-2xl bg-[#030509] border border-[#8296DC]/15 p-4 font-mono text-xs text-[#9EA8B8] space-y-1 overflow-x-auto">
          <div class="text-[#667085]">// Arch Linux environment:</div>
          <div class="text-[#F8FAFF]"><span class="text-[#6684FF]">[syntac@arch-arm64]$</span> pacman -S --noconfirm git python</div>
          <div class="text-[#6EE7B7]">resolving dependencies...</div>
          <div class="text-[#6EE7B7]">installed: python-3.13.2-1</div>
        </div>
      </div>

      <!-- Card 2: Termux Bridge -->
      <div class="shiny-glass rounded-3xl p-6 sm:p-8 space-y-6 border border-[#8296DC]/15 flex flex-col justify-between">
        <div class="space-y-5">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-[#0D1420] border border-[#8296DC]/25 flex items-center justify-center text-[#FCD34D]">
                <Terminal class="w-5 h-5" />
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#F8FAFF]">Termux Bridge</h3>
                <p class="text-xs font-mono text-[#FCD34D]">RUN_COMMAND • Android Inter-Process</p>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold font-mono bg-[#F59E0B]/15 text-[#FCD34D] border border-[#F59E0B]/30">
              Optional Bridge
            </span>
          </div>

          <p class="text-sm text-[#9EA8B8] leading-relaxed">
            Connects to an existing Termux setup over Android's <code class="font-mono text-[#91A7FF] text-xs">com.termux.RUN_COMMAND</code> permission to reuse packages, dotfiles, and development configurations.
          </p>

          <!-- Setup snippet box -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-[#667085] font-mono">
              <span>TERMUX SETUP SCRIPT</span>
              <button id="copy-termux-btn" class="text-[#91A7FF] hover:text-white transition-colors cursor-pointer flex items-center gap-1">
                <Copy class="w-3 h-3" />
                <span id="copy-label">Copy</span>
              </button>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#030509] border border-[#8296DC]/15 font-mono text-xs text-[#F8FAFF] overflow-x-auto">
              <pre id="termux-code" class="whitespace-pre-wrap">mkdir -p ~/.termux
printf 'allow-external-apps=true\n' >> ~/.termux/termux.properties
termux-reload-settings
termux-setup-storage</pre>
            </div>
          </div>
        </div>

        <p class="text-xs text-[#667085] font-mono">
          Grant Syntac the Termux command permission from Android App Settings to enable.
        </p>
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-termux-btn');
  const codeEl = document.getElementById('termux-code');
  const copyLabel = document.getElementById('copy-label');

  copyBtn?.addEventListener('click', async () => {
    if (codeEl && copyLabel) {
      await navigator.clipboard.writeText(codeEl.innerText);
      copyLabel.innerText = 'Copied!';
      setTimeout(() => {
        copyLabel.innerText = 'Copy';
      }, 2000);
    }
  });
</script>
