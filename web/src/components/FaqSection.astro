---
import { FAQS } from '../data/appData';
import { HelpCircle, ChevronDown } from 'lucide-astro';
---

<section id="faq" class="py-24 relative z-10 border-t border-[#8296DC]/12 bg-[#05070C]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#6684FF]/10 text-[#91A7FF] border border-[#6684FF]/25 font-mono">
        <HelpCircle class="w-3 h-3 text-[#6684FF]" />
        <span>FAQ</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F8FAFF]">
        Frequently Asked Questions
      </h2>
      <p class="text-base sm:text-lg text-[#9EA8B8]">
        Everything you need to know about permissions, storage, AI keys, and Android architecture.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {FAQS.map((faq, index) => (
        <div class="shiny-glass-card rounded-2xl border border-[#8296DC]/15 overflow-hidden transition-all">
          <button
            type="button"
            class="faq-toggle-btn w-full p-5 sm:p-6 text-left flex items-center justify-between gap-4 cursor-pointer focus:outline-none"
            aria-expanded={index === 0 ? 'true' : 'false'}
            data-index={index}
          >
            <span class="text-base sm:text-lg font-semibold text-[#F8FAFF] hover:text-[#91A7FF] transition-colors">
              {faq.q}
            </span>
            <div class="faq-icon shrink-0 w-8 h-8 rounded-full bg-[#0D1420] border border-[#8296DC]/20 flex items-center justify-center text-[#9EA8B8] transition-transform duration-200">
              <ChevronDown class="w-4 h-4" />
            </div>
          </button>
          
          <div class={`faq-content px-5 sm:px-6 pb-6 pt-0 text-sm text-[#9EA8B8] leading-relaxed ${index === 0 ? 'block' : 'hidden'}`}>
            <p>{faq.a}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const faqButtons = document.querySelectorAll<HTMLButtonElement>('.faq-toggle-btn');

  faqButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      const content = btn.nextElementSibling as HTMLElement;
      const icon = btn.querySelector('.faq-icon') as HTMLElement;

      btn.setAttribute('aria-expanded', String(!isExpanded));
      if (content) {
        content.classList.toggle('hidden');
      }
      if (icon) {
        icon.style.transform = isExpanded ? 'rotate(0deg)' : 'rotate(180deg)';
      }
    });
  });
</script>
