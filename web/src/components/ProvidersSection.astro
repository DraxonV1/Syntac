---
import { PROVIDERS } from '../data/appData';
import { Sparkles, Key, Check, Bot, Globe, Shield, Terminal, ArrowRight } from 'lucide-astro';
---

<section id="providers" class="py-24 relative z-10 border-t border-[#8296DC]/12 bg-[#05070C]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#6684FF]/10 text-[#91A7FF] border border-[#6684FF]/25 font-mono">
        <Sparkles class="w-3 h-3 text-[#6684FF]" />
        <span>Supported Providers</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#F8FAFF]">
        Connect Any Frontier Model
      </h2>
      <p class="text-base sm:text-lg text-[#9EA8B8]">
        Syntac connects directly from your phone to OAuth-authorized or API-keyed AI backends with streaming responses and function calling.
      </p>
    </div>

    <!-- Provider Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {PROVIDERS.map((provider) => (
        <div class="shiny-glass rounded-3xl p-6 sm:p-8 flex flex-col justify-between border border-[#8296DC]/15 relative overflow-hidden group">
          
          <div class="space-y-6">
            <!-- Header Row -->
            <div class="flex items-start justify-between gap-4">
              <div class="space-y-1">
                <div class="flex items-center gap-2.5">
                  <h3 class="text-xl font-bold text-[#F8FAFF] group-hover:text-white transition-colors">
                    {provider.name}
                  </h3>
                </div>
                <div class="flex items-center gap-1.5 text-xs font-mono text-[#91A7FF]">
                  <Key class="w-3 h-3" />
                  <span>{provider.authType}</span>
                </div>
              </div>

              <span class="px-2.5 py-1 rounded-full text-xs font-semibold font-mono bg-[#6684FF]/15 text-[#B8C5FF] border border-[#6684FF]/30">
                {provider.badge}
              </span>
            </div>

            <!-- Description -->
            <p class="text-sm text-[#9EA8B8] leading-relaxed">
              {provider.description}
            </p>

            <!-- Capabilities Matrix -->
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-wider text-[#667085] font-mono">
                Capabilities
              </div>
              <div class="flex flex-wrap gap-2">
                <span class={`px-2 py-1 rounded-lg text-xs font-mono flex items-center gap-1.5 ${provider.capabilities.streaming ? 'bg-[#10B981]/15 text-[#6EE7B7] border border-[#10B981]/30' : 'bg-[#080C14] text-[#667085] line-through'}`}>
                  <Check class="w-3 h-3" />
                  Streaming
                </span>
                <span class={`px-2 py-1 rounded-lg text-xs font-mono flex items-center gap-1.5 ${provider.capabilities.tools ? 'bg-[#10B981]/15 text-[#6EE7B7] border border-[#10B981]/30' : 'bg-[#080C14] text-[#667085] line-through'}`}>
                  <Check class="w-3 h-3" />
                  Agent Tools
                </span>
                {provider.capabilities.reasoning && (
                  <span class="px-2 py-1 rounded-lg text-xs font-mono flex items-center gap-1.5 bg-[#6684FF]/15 text-[#91A7FF] border border-[#6684FF]/30">
                    <Sparkles class="w-3 h-3" />
                    Deep Reasoning
                  </span>
                )}
                {provider.capabilities.images && (
                  <span class="px-2 py-1 rounded-lg text-xs font-mono flex items-center gap-1.5 bg-[#6684FF]/15 text-[#91A7FF] border border-[#6684FF]/30">
                    Vision Input
                  </span>
                )}
              </div>
            </div>

            <!-- Default Models -->
            <div class="space-y-2">
              <div class="text-xs font-semibold uppercase tracking-wider text-[#667085] font-mono">
                Available Models
              </div>
              <div class="flex flex-wrap gap-1.5">
                {provider.models.map((model) => (
                  <code class="px-2.5 py-1 rounded-lg bg-[#080C14] border border-[#8296DC]/15 text-xs font-mono text-[#F8FAFF]">
                    {model}
                  </code>
                ))}
              </div>
            </div>
          </div>

          <!-- Setup Guide Box -->
          <div class="mt-6 pt-5 border-t border-[#8296DC]/10">
            <div class="p-3.5 rounded-2xl bg-[#080C14]/80 border border-[#8296DC]/12 space-y-1 text-xs">
              <div class="font-semibold text-[#F8FAFF] flex items-center gap-1.5 font-mono">
                <Shield class="w-3.5 h-3.5 text-[#6684FF]" />
                <span>Authentication Flow</span>
              </div>
              <p class="text-[#9EA8B8] leading-relaxed">
                {provider.setupGuide}
              </p>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
