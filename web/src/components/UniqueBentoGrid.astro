---
import { Smartphone, FileEdit, ShieldCheck, Sparkles, Cpu, FolderGit2 } from 'lucide-astro';
---

<section id="features" class="py-24 relative z-10 border-t border-[#8296DC]/12 bg-[#05070C]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-[#6684FF]/10 text-[#91A7FF] border border-[#6684FF]/25">
        <Smartphone class="w-3 h-3 text-[#6684FF]" />
        <span>Built for Android</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[#F8FAFF]">
        Serious Software Engineering on Your Phone
      </h2>
      <p class="text-base sm:text-lg text-[#8E99AA] font-normal">
        A native mobile environment built to inspect repositories, execute tasks, and write clean code anywhere.
      </p>
    </div>

    <!-- Android Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Bento 1: Native Android Architecture (Spans 2 cols on md) -->
      <div class="md:col-span-2 syntac-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between space-y-6 relative overflow-hidden group">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-[#0D1420] border border-[#8296DC]/20 flex items-center justify-center text-[#91A7FF]">
              <Smartphone class="w-5 h-5" />
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-[#080C14] text-[#10B981] border border-[#10B981]/25">
              Android 8.0+ Native
            </span>
          </div>

          <div class="space-y-2">
            <h3 class="text-xl sm:text-2xl font-semibold text-[#F8FAFF]">
              Built Exclusively for Android Devices
            </h3>
            <p class="text-sm text-[#8E99AA] leading-relaxed max-w-xl font-normal">
              Designed from the ground up for mobile screens with high-refresh rate fluidity, on-device project storage access, swipeable diff cards, and local command execution right on your phone.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 pt-2 text-xs font-mono text-[#8E99AA]">
          <div class="p-3 rounded-2xl bg-[#030509] border border-[#8296DC]/12 space-y-0.5">
            <div class="text-[#F8FAFF] font-medium font-sans">Direct Storage</div>
            <div class="text-[11px] text-[#4E5666]">Open local project folders</div>
          </div>
          <div class="p-3 rounded-2xl bg-[#030509] border border-[#8296DC]/12 space-y-0.5">
            <div class="text-[#F8FAFF] font-medium font-sans">ARM64 Native</div>
            <div class="text-[11px] text-[#4E5666]">Optimized 64-bit performance</div>
          </div>
          <div class="p-3 rounded-2xl bg-[#030509] border border-[#8296DC]/12 space-y-0.5 col-span-2 sm:col-span-1">
            <div class="text-[#F8FAFF] font-medium font-sans">On-Device State</div>
            <div class="text-[11px] text-[#4E5666]">Zero cloud reliance</div>
          </div>
        </div>
      </div>

      <!-- Bento 2: Surgical Diffs -->
      <div class="syntac-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between space-y-6 group">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-2xl bg-[#0D1420] border border-[#8296DC]/20 flex items-center justify-center text-[#6684FF]">
            <FileEdit class="w-5 h-5" />
          </div>

          <div class="space-y-2">
            <h3 class="text-xl font-semibold text-[#F8FAFF]">
              Surgical Line Edits
            </h3>
            <p class="text-sm text-[#8E99AA] leading-relaxed font-normal">
              Replaces targeted code blocks with exact uniqueness matching instead of rewriting entire files, saving prompt tokens and eliminating accidental code drops.
            </p>
          </div>
        </div>

        <div class="p-3 rounded-2xl bg-[#030509] border border-[#8296DC]/15 font-mono text-[11px] space-y-1">
          <div class="text-[#EF4444] bg-[#EF4444]/10 px-1.5 py-0.5 rounded-xs">- const port = 3000;</div>
          <div class="text-[#10B981] bg-[#10B981]/10 px-1.5 py-0.5 rounded-xs">+ const port = env.PORT || 8080;</div>
        </div>
      </div>

      <!-- Bento 3: Zero Telemetry Privacy -->
      <div class="syntac-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between space-y-6 group">
        <div class="space-y-4">
          <div class="w-10 h-10 rounded-2xl bg-[#0D1420] border border-[#8296DC]/20 flex items-center justify-center text-[#10B981]">
            <ShieldCheck class="w-5 h-5" />
          </div>

          <div class="space-y-2">
            <h3 class="text-xl font-semibold text-[#F8FAFF]">
              100% On-Device Privacy
            </h3>
            <p class="text-sm text-[#8E99AA] leading-relaxed font-normal">
              Your source code, project files, chat logs, and API tokens remain stored exclusively on your Android device. Zero proprietary middleman servers, zero analytics.
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 text-xs font-mono text-[#10B981]">
          <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
          <span>Encrypted Keystore Storage</span>
        </div>
      </div>

      <!-- Bento 4: Frontier Intelligence (Spans 2 cols on md) -->
      <div class="md:col-span-2 syntac-glass rounded-3xl p-7 sm:p-9 flex flex-col justify-between space-y-6 relative overflow-hidden group">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <div class="w-10 h-10 rounded-2xl bg-[#0D1420] border border-[#8296DC]/20 flex items-center justify-center text-[#91A7FF]">
              <Sparkles class="w-5 h-5" />
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-[#080C14] text-[#91A7FF] border border-[#6684FF]/30">
              OAuth & OpenAI Compatible
            </span>
          </div>

          <div class="space-y-2">
            <h3 class="text-xl sm:text-2xl font-semibold text-[#F8FAFF]">
              Frontier AI Model Connectivity
            </h3>
            <p class="text-sm text-[#8E99AA] leading-relaxed max-w-xl font-normal">
              Connect Google Cloud Code Assist via 1-tap PKCE OAuth with Gemini 3, or configure any OpenAI-compatible endpoint to drive Claude, GPT-OSS, and custom models directly from your phone.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs">
          <span class="px-3 py-1 rounded-xl bg-[#080C14] border border-[#8296DC]/20 text-[#F8FAFF]">
            Gemini 3
          </span>
          <span class="px-3 py-1 rounded-xl bg-[#080C14] border border-[#8296DC]/20 text-[#F8FAFF]">
            Claude
          </span>
          <span class="px-3 py-1 rounded-xl bg-[#080C14] border border-[#8296DC]/20 text-[#F8FAFF]">
            GPT-OSS
          </span>
          <span class="px-3 py-1 rounded-xl bg-[#080C14] border border-[#8296DC]/20 text-[#F8FAFF]">
            Custom /v1 Endpoints
          </span>
        </div>
      </div>

    </div>

  </div>
</section>
