---
import Layout from '../layouts/Layout.astro';
import { APP_CONFIG, RELEASES } from '../data/appData';
import { Download, Copy, CheckCircle2, Smartphone } from 'lucide-astro';

const currentRelease = RELEASES[0];
---

<Layout
  title={`Download ${APP_CONFIG.name} — APK Releases for Android`}
  description={`Download Syntac v${APP_CONFIG.currentVersion} for Android. Autonomous local-first coding agent built for Android devices.`}
>
  <div class="py-16 sm:py-24 relative overflow-hidden">
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Page Header -->
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-mono bg-[#10B981]/15 text-[#6EE7B7] border border-[#10B981]/30">
          <Smartphone class="w-3.5 h-3.5" />
          <span>Android Release Ready</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-[#F8FAFF]">
          Download {APP_CONFIG.name} for Android
        </h1>
        <p class="text-base sm:text-lg text-[#8E99AA] font-normal">
          Install the APK directly onto your ARM64 Android device.
        </p>
      </div>

      <!-- Main Download Hero Card -->
      <div class="max-w-4xl mx-auto mb-16">
        <div class="syntac-glass rounded-3xl p-8 sm:p-10 border border-[#6684FF]/40 relative overflow-hidden space-y-8 shadow-2xl">
          
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-6 border-b border-[#8296DC]/15">
            <div class="space-y-1">
              <div class="flex items-center gap-3">
                <h2 class="text-2xl sm:text-3xl font-semibold text-[#F8FAFF]">
                  Syntac for Android (Beta)
                </h2>
                <span class="px-3 py-1 rounded-full text-xs font-mono font-medium bg-[#6684FF]/20 text-[#91A7FF] border border-[#6684FF]/40">
                  v{currentRelease.version}
                </span>
              </div>
              <p class="text-xs font-mono text-[#667085]">
                Package: <span class="text-[#8E99AA]">{APP_CONFIG.packageId}</span> • Version Code: <span class="text-[#8E99AA]">{currentRelease.versionCode}</span> • Arch: <span class="text-[#8E99AA]">ARM64-v8a</span>
              </p>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                href={currentRelease.apkUrl}
                class="glow-btn inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-2xl text-sm font-medium text-white bg-[#6684FF] hover:bg-[#91A7FF] shadow-lg shadow-[#6684FF]/30 border border-[#91A7FF]/30 transition-all active:scale-95 text-center"
              >
                <Download class="w-4 h-4" />
                <span>Download APK ({currentRelease.sizeFormatted})</span>
              </a>
            </div>
          </div>

          <!-- Release Highlights -->
          <div class="space-y-3">
            <h3 class="text-xs uppercase tracking-wider text-[#667085] font-mono">Highlights</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-[#F8FAFF]">
              {currentRelease.highlights.map((item) => (
                <li class="flex items-start gap-2.5">
                  <CheckCircle2 class="w-4 h-4 text-[#10B981] shrink-0 mt-0.5" />
                  <span class="text-[#8E99AA] text-xs leading-relaxed font-normal">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- SHA256 Verification -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs text-[#667085] font-mono">
              <span>SHA-256 VERIFICATION HASH</span>
              <button id="copy-sha-btn" class="text-[#91A7FF] hover:text-white transition-colors cursor-pointer flex items-center gap-1">
                <Copy class="w-3 h-3" />
                <span id="sha-copy-label">Copy Hash</span>
              </button>
            </div>
            <div class="p-3.5 rounded-2xl bg-[#030509] border border-[#8296DC]/15 font-mono text-xs text-[#6EE7B7] break-all select-all">
              <span id="sha-hash">{currentRelease.sha256}</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Update Channels -->
      <div class="max-w-4xl mx-auto mb-16 space-y-6">
        <h2 class="text-2xl font-semibold text-[#F8FAFF]">Update Channels & Manifests</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {RELEASES.map((rel) => (
            <div class="syntac-card rounded-3xl p-6 space-y-4 border border-[#8296DC]/15 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-mono uppercase tracking-wider text-[#91A7FF]">
                    {rel.channel}
                  </span>
                  <span class={`px-2 py-0.5 rounded text-[10px] font-mono ${rel.channel === 'beta' ? 'bg-[#6684FF]/15 text-[#91A7FF]' : 'bg-[#080C14] text-[#667085]'}`}>
                    {rel.channel === 'beta' ? 'Default' : 'Channel'}
                  </span>
                </div>
                
                <div class="space-y-1">
                  <h3 class="text-lg font-semibold text-[#F8FAFF]">v{rel.version}</h3>
                  <p class="text-xs text-[#8E99AA] leading-relaxed font-normal">
                    {rel.channel === 'beta' && 'Current default channel with rapid fixes and mobile provider enhancements.'}
                    {rel.channel === 'stable' && 'Public releases tested across physical Android devices.'}
                    {rel.channel === 'nightly' && 'Bleeding edge automated builds from repository master.'}
                  </p>
                </div>
              </div>

              <div class="pt-3 border-t border-[#8296DC]/10">
                <a
                  href={`https://raw.githubusercontent.com/DraxonV1/Syntac/main/update/${rel.channel}.json`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-mono text-[#91A7FF] hover:text-white flex items-center gap-1.5"
                >
                  <span>update/{rel.channel}.json</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Installation Guide -->
      <div class="max-w-4xl mx-auto mb-16 space-y-6">
        <h2 class="text-2xl font-semibold text-[#F8FAFF]">Android Installation Walkthrough</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="syntac-card rounded-3xl p-6 space-y-3 border border-[#8296DC]/15">
            <div class="w-8 h-8 rounded-xl bg-[#0D1420] text-[#91A7FF] flex items-center justify-center font-mono text-sm border border-[#8296DC]/20">
              1
            </div>
            <h3 class="text-base font-semibold text-[#F8FAFF]">Allow APK Sideloading</h3>
            <p class="text-xs text-[#8E99AA] leading-relaxed font-normal">
              When downloading the APK, tap Settings and toggle Allow from this source to install.
            </p>
          </div>

          <div class="syntac-card rounded-3xl p-6 space-y-3 border border-[#8296DC]/15">
            <div class="w-8 h-8 rounded-xl bg-[#0D1420] text-[#91A7FF] flex items-center justify-center font-mono text-sm border border-[#8296DC]/20">
              2
            </div>
            <h3 class="text-base font-semibold text-[#F8FAFF]">Connect Model</h3>
            <p class="text-xs text-[#8E99AA] leading-relaxed font-normal">
              Connect Google Cloud Code Assist with 1-tap OAuth, or enter your OpenAI-compatible API keys.
            </p>
          </div>

          <div class="syntac-card rounded-3xl p-6 space-y-3 border border-[#8296DC]/15">
            <div class="w-8 h-8 rounded-xl bg-[#0D1420] text-[#91A7FF] flex items-center justify-center font-mono text-sm border border-[#8296DC]/20">
              3
            </div>
            <h3 class="text-base font-semibold text-[#F8FAFF]">Select Project Folder</h3>
            <p class="text-xs text-[#8E99AA] leading-relaxed font-normal">
              Pick any local folder on your Android device to begin inspecting code and executing tasks.
            </p>
          </div>

          <div class="syntac-card rounded-3xl p-6 space-y-3 border border-[#8296DC]/15">
            <div class="w-8 h-8 rounded-xl bg-[#0D1420] text-[#91A7FF] flex items-center justify-center font-mono text-sm border border-[#8296DC]/20">
              4
            </div>
            <h3 class="text-base font-semibold text-[#F8FAFF]">Autonomous Coding</h3>
            <p class="text-xs text-[#8E99AA] leading-relaxed font-normal">
              Ask Syntac to refactor code, fix bugs, or build new features directly from your phone.
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-sha-btn');
  const hashEl = document.getElementById('sha-hash');
  const copyLabel = document.getElementById('sha-copy-label');

  copyBtn?.addEventListener('click', async () => {
    if (hashEl && copyLabel) {
      await navigator.clipboard.writeText(hashEl.innerText.trim());
      copyLabel.innerText = 'Copied!';
      setTimeout(() => {
        copyLabel.innerText = 'Copy Hash';
      }, 2000);
    }
  });
</script>
